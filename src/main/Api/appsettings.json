{
  "Application": {
    "Name": "gRPC.Server.Api",
    "Version": "1.0.0"
  },
  "Serilog": {
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '/metrics' or RequestPath like '/health' or RequestPath like '/favicon%'"
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http1Cleartext": {
        "Url": "http://*:7000",
        "Protocols": "Http1"
      },
      "Http2Cleartext": {
        "Url": "http://*:7001",
        "Protocols": "Http2"
      }
    }
  }
}
