        <mxCell id="tudUSvy4zYmbnAaiKVAG-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;span&gt;syntax = &quot;proto3&quot;;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;package profile.v1;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;option csharp_namespace = &quot;Contracts.Profile.V1&quot;;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;service ProfileService {&lt;/span&gt;&lt;br&gt;&lt;span&gt;  rpc GetProfile (GetProfileRequest) returns (ProfileResponse);&lt;/span&gt;&lt;br&gt;&lt;span&gt;}&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;message GetProfileRequest {&lt;/span&gt;&lt;br&gt;&lt;span&gt;  string id = 1;&lt;/span&gt;&lt;br&gt;&lt;span&gt;}&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;message ProfileResponse {&lt;/span&gt;&lt;br&gt;&lt;span&gt;  string id = 1;&lt;/span&gt;&lt;br&gt;&lt;span&gt;  string full_name = 2;&lt;/span&gt;&lt;br&gt;&lt;span&gt;  string birth_date = 3;&lt;/span&gt;&lt;br&gt;&lt;span&gt;  string gender = 4;&lt;/span&gt;&lt;br&gt;&lt;span&gt;  string cpf = 5;&lt;/span&gt;&lt;br&gt;&lt;span&gt;  string status = 6;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;  // Novos campos adicionados de forma compatível&lt;/span&gt;&lt;br&gt;&lt;span&gt;  string email = 7;&lt;/span&gt;&lt;br&gt;&lt;span&gt;  string phone_number = 8;&lt;/span&gt;&lt;br&gt;&lt;span&gt;  string created_at = 9;&lt;/span&gt;&lt;br&gt;&lt;span&gt;}&lt;/span&gt;" vertex="1">
