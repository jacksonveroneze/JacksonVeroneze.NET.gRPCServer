        <mxCell id="tudUSvy4zYmbnAaiKVAG-4" parent="1" style="text;whiteSpace=wrap;" value="syntax = &quot;proto3&quot;;&#xa;&#xa;&#xa;package profile.v2;&#xa;&#xa;&#xa;option csharp_namespace = &quot;Contracts.Profile.V2&quot;;&#xa;&#xa;&#xa;service ProfileService {&#xa;  rpc GetProfile (GetProfileRequest) returns (ProfileResponse);&#xa;}&#xa;&#xa;&#xa;message GetProfileRequest {&#xa;  string id = 1;&#xa;}&#xa;&#xa;&#xa;message ProfileResponse {&#xa;  string id = 1;&#xa;  string full_name = 2;&#xa;&#xa;&#xa;  Date birth_date = 3;&#xa;  ProfileStatus status = 4;&#xa;&#xa;&#xa;  string email = 5;&#xa;  string phone_number = 6;&#xa;&#xa;&#xa;  Document document = 7;&#xa;}&#xa;&#xa;&#xa;message Date {&#xa;  int32 year = 1;&#xa;  int32 month = 2;&#xa;  int32 day = 3;&#xa;}&#xa;&#xa;&#xa;message Document {&#xa;  string type = 1;&#xa;  string value = 2;&#xa;}&#xa;&#xa;&#xa;enum ProfileStatus {&#xa;  PROFILE_STATUS_UNSPECIFIED = 0;&#xa;  PROFILE_STATUS_PENDING_ACTIVATION = 1;&#xa;  PROFILE_STATUS_ACTIVE = 2;&#xa;  PROFILE_STATUS_INACTIVE = 3;&#xa;  PROFILE_STATUS_BLOCKED = 4;&#xa;}" vertex="1">
