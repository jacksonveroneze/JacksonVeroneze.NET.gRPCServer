        <mxCell id="TrECbXBoXLdmp5ztJvj4-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Tema&lt;/th&gt;&lt;th&gt;Recomendação&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Contrato&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Versionar &lt;code&gt;.proto&lt;/code&gt; e evitar mudanças breaking.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Timeout/deadline&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Toda chamada client deve ter deadline.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Cancelamento&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Propagar cancelamento para evitar trabalho desnecessário.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Retry&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Usar apenas para falhas transitórias e operações seguras.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Idempotência&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Usar &lt;code&gt;idempotency_key&lt;/code&gt; em comandos críticos.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Observabilidade&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Medir latência, status code, erro, retry, timeout e payload.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Segurança&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Usar TLS, autenticação e autorização por metadata.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Correlação&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Propagar &lt;code&gt;x-correlation-id&lt;/code&gt; ou &lt;code&gt;traceparent&lt;/code&gt;.&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="190" width="460" x="-2650" y="2260" as="geometry" />
        </mxCell>
