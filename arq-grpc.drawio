  <diagram id="AsM-uAYhwsxeHPPCYZhr" name="Página-3">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="CtFXKMa_8wtHnJRDGDTb-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Ponto&lt;/th&gt;&lt;th&gt;Resumo&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;O que é&lt;/td&gt;&lt;td&gt;Tecnologia RPC para comunicação entre serviços, baseada em contratos &lt;code&gt;.proto&lt;/code&gt;.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Melhor uso&lt;/td&gt;&lt;td&gt;Comunicação service-to-service, alto volume, payloads estruturados, baixa latência, streaming e contratos fortemente tipados.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Principal diferencial&lt;/td&gt;&lt;td&gt;Protobuf binário + HTTP/2 + geração de código cliente/servidor.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Quando evitar&lt;/td&gt;&lt;td&gt;APIs públicas para browsers, integrações externas simples, cenários onde debug manual e compatibilidade ampla são prioridade.&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="170" width="560" x="20" y="50" as="geometry" />
        </mxCell>
        <mxCell id="CtFXKMa_8wtHnJRDGDTb-2" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Critério&lt;/th&gt;&lt;th&gt;REST&lt;/th&gt;&lt;th&gt;gRPC&lt;/th&gt;&lt;th&gt;Leitura arquitetural&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;Modelo&lt;/td&gt;&lt;td&gt;Recursos/endpoints&lt;/td&gt;&lt;td&gt;Métodos remotos&lt;/td&gt;&lt;td&gt;gRPC modela melhor operações service-to-service.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Contrato&lt;/td&gt;&lt;td&gt;OpenAPI opcional&lt;/td&gt;&lt;td&gt;&lt;code&gt;.proto&lt;/code&gt; obrigatório&lt;/td&gt;&lt;td&gt;gRPC força contrato forte e reduz ambiguidade.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Serialização&lt;/td&gt;&lt;td&gt;JSON textual&lt;/td&gt;&lt;td&gt;Protobuf binário&lt;/td&gt;&lt;td&gt;gRPC tende a trafegar menos bytes.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Transporte&lt;/td&gt;&lt;td&gt;HTTP/1.1 ou HTTP/2&lt;/td&gt;&lt;td&gt;HTTP/2&lt;/td&gt;&lt;td&gt;gRPC usa multiplexação e conexão persistente por padrão.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Tipagem&lt;/td&gt;&lt;td&gt;Mais flexível&lt;/td&gt;&lt;td&gt;Fortemente tipado&lt;/td&gt;&lt;td&gt;gRPC reduz erros de integração.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Streaming&lt;/td&gt;&lt;td&gt;Limitado/alternativo&lt;/td&gt;&lt;td&gt;Nativo&lt;/td&gt;&lt;td&gt;gRPC é superior para fluxos contínuos.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Debug manual&lt;/td&gt;&lt;td&gt;Mais simples&lt;/td&gt;&lt;td&gt;Menos simples&lt;/td&gt;&lt;td&gt;REST é melhor para inspeção via browser/curl.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Uso externo&lt;/td&gt;&lt;td&gt;Muito adequado&lt;/td&gt;&lt;td&gt;Exige mais preparo&lt;/td&gt;&lt;td&gt;REST segue melhor para APIs públicas.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Uso interno&lt;/td&gt;&lt;td&gt;Bom&lt;/td&gt;&lt;td&gt;Muito indicado&lt;/td&gt;&lt;td&gt;gRPC se destaca em comunicação entre microsserviços.&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="310" width="560" x="20" y="230" as="geometry" />
        </mxCell>
        <mxCell id="CtFXKMa_8wtHnJRDGDTb-3" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Trade-off&lt;/th&gt;&lt;th&gt;Impacto arquitetural&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;Curva de aprendizado maior&lt;/td&gt;&lt;td&gt;Time precisa entender &lt;code&gt;.proto&lt;/code&gt;, HTTP/2, metadata, status codes e geração de código.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Menor legibilidade humana&lt;/td&gt;&lt;td&gt;Payload binário é eficiente para máquinas, mas pior para debug manual.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Testabilidade manual menos natural&lt;/td&gt;&lt;td&gt;Ferramentas comuns como browser e curl não são tão práticas quanto no REST.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Acoplamento por contrato&lt;/td&gt;&lt;td&gt;Exige governança de versionamento e compatibilidade de contratos.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Infra precisa suportar HTTP/2&lt;/td&gt;&lt;td&gt;Load balancers, proxies, API gateways e observabilidade precisam estar preparados.&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="210" width="560" x="30" y="570" as="geometry" />
        </mxCell>
        <mxCell id="CtFXKMa_8wtHnJRDGDTb-4" parent="1" style="text;whiteSpace=wrap;html=1;" value="Tabela resumo — Uso de gRPC" vertex="1">
          <mxGeometry height="40" width="200" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="CtFXKMa_8wtHnJRDGDTb-5" parent="1" style="text;whiteSpace=wrap;html=1;" value="Comparativo objetivo — REST vs gRPC" vertex="1">
          <mxGeometry height="40" width="250" x="20" y="210" as="geometry" />
        </mxCell>
        <mxCell id="CtFXKMa_8wtHnJRDGDTb-6" parent="1" style="text;whiteSpace=wrap;html=1;" value="Trade-offs" vertex="1">
          <mxGeometry height="40" width="90" x="30" y="550" as="geometry" />
        </mxCell>
        <mxCell id="CtFXKMa_8wtHnJRDGDTb-7" parent="1" style="text;whiteSpace=wrap;html=1;" value="Onde o ganho aparece na prática" vertex="1">
          <mxGeometry height="40" width="210" x="30" y="840" as="geometry" />
        </mxCell>
        <mxCell id="CtFXKMa_8wtHnJRDGDTb-8" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Métrica&lt;/th&gt;&lt;th&gt;Expectativa com gRPC&lt;/th&gt;&lt;th&gt;Observado no teste&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;Latência média&lt;/td&gt;&lt;td&gt;Pode reduzir&lt;/td&gt;&lt;td&gt;Não reduziu; ficou próxima do REST.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;p95&lt;/td&gt;&lt;td&gt;Pode melhorar&lt;/td&gt;&lt;td&gt;REST ficou levemente melhor.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Throughput&lt;/td&gt;&lt;td&gt;Pode aumentar&lt;/td&gt;&lt;td&gt;REST teve maior throughput.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CPU por request&lt;/td&gt;&lt;td&gt;Pode reduzir&lt;/td&gt;&lt;td&gt;gRPC teve CPU média levemente menor.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Alocação/memória&lt;/td&gt;&lt;td&gt;Pode reduzir&lt;/td&gt;&lt;td&gt;gRPC usou menos memória e pressionou menos o heap.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Bytes trafegados&lt;/td&gt;&lt;td&gt;Deve reduzir&lt;/td&gt;&lt;td&gt;gRPC reduziu fortemente o tráfego de rede.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;GC/fragmentação&lt;/td&gt;&lt;td&gt;Pode reduzir&lt;/td&gt;&lt;td&gt;gRPC teve menor heap, LOH/POH e fragmentação.&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="200" width="560" x="30" y="870" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
